<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8 col-xl-7">

    <div class="med-page-header">
      <div class="med-page-badge">
        <i class="fa-solid fa-square-poll-vertical"></i> Clinical Inference Result
      </div>
      <h1 class="med-page-title">Diagnostic Assessment Report</h1>
      <p class="med-page-desc">
        Generated by MEDORA predictive disease intelligence classifier based on evaluated clinical biomarkers.
      </p>
    </div>

    <div class="med-card text-center p-4 p-md-5">
      <% if (pred === 1) { %>
        <!-- Positive Outcome -->
        <div style="width: 72px; height: 72px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 20px;">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <div class="d-inline-block px-3 py-1 rounded-pill mb-2 font-weight-bold" style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 12px; letter-spacing: 0.5px; text-transform: uppercase;">
          Positive Indication Detected
        </div>

        <h2 class="font-weight-bold text-dark mb-2" style="font-size: 24px;">
          High Risk of Disease Indicator
        </h2>
        
        <p class="text-muted mx-auto mb-4" style="max-width: 520px; font-size: 14px; line-height: 1.6;">
          The submitted clinical biometric profile shows patterns closely associated with positive pathological markers. Immediate medical evaluation is strongly recommended.
        </p>

        <!-- Recommendations Block -->
        <div class="text-left p-3 mb-4" style="background: #fff1f2; border-radius: 12px; border: 1px solid #ffe4e6;">
          <div class="font-weight-bold text-danger mb-2 d-flex align-items-center gap-2" style="font-size: 13px;">
            <i class="fa-solid fa-clipboard-check"></i> Recommended Clinical Next Steps:
          </div>
          <ul class="mb-0 pl-3 text-muted" style="font-size: 12px; line-height: 1.7;">
            <li>Consult a licensed physician or specialist for formal confirmatory laboratory diagnostic testing.</li>
            <li>Monitor vital signs and record symptom frequency in your personal health log.</li>
            <li>Avoid initiating or discontinuing medications without professional medical guidance.</li>
          </ul>
        </div>

      <% } else { %>
        <!-- Negative Outcome -->
        <div style="width: 72px; height: 72px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 20px;">
          <i class="fa-solid fa-circle-check"></i>
        </div>

        <div class="d-inline-block px-3 py-1 rounded-pill mb-2 font-weight-bold" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 12px; letter-spacing: 0.5px; text-transform: uppercase;">
          Negative / Normal Range
        </div>

        <h2 class="font-weight-bold text-dark mb-2" style="font-size: 24px;">
          No Acute Disease Indicators Detected
        </h2>
        
        <p class="text-muted mx-auto mb-4" style="max-width: 520px; font-size: 14px; line-height: 1.6;">
          The evaluated biometric biomarkers align within typical healthy physiological baselines. The model predicts a low risk probability for this condition.
        </p>

        <!-- Wellness Recommendations Block -->
        <div class="text-left p-3 mb-4" style="background: #f0fdf4; border-radius: 12px; border: 1px solid #dcfce7;">
          <div class="font-weight-bold text-success mb-2 d-flex align-items-center gap-2" style="font-size: 13px;">
            <i class="fa-solid fa-shield-heart"></i> Preventive Health Recommendations:
          </div>
          <ul class="mb-0 pl-3 text-muted" style="font-size: 12px; line-height: 1.7;">
            <li>Maintain standard annual preventative wellness screenings and check-ups.</li>
            <li>Adhere to balanced dietary habits, regular physical activity, and sufficient sleep hygiene.</li>
            <li>Re-test if new symptoms or changes in health baseline emerge.</li>
          </ul>
        </div>
      <% } %>

      <!-- Action Buttons -->
      <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 pt-3 border-top">
        <a href="/" class="btn-med-primary">
          <i class="fa-solid fa-house"></i> Diagnostic Directory
        </a>
        <button type="button" class="btn-med-secondary" onclick="window.history.back()">
          <i class="fa-solid fa-rotate-left"></i> Test Another Sample
        </button>
        <button type="button" class="btn-med-secondary" onclick="window.print()">
          <i class="fa-solid fa-print"></i> Print Report
        </button>
      </div>

    </div>

  </div>
</div>

<%- include('partials/footer') %>
